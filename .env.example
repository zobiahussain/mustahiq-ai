# Staff portal demo mode. Uses synthetic SQLite data and does not call Supabase.
PORTAL_DEMO_MODE=true
PORTAL_DEMO_DATABASE=.local/staff-demo.sqlite3
STAFF_GENERATION_ENABLED=false
SUPPORT_CHAT_USE_LLM=true
STAFF_PORTAL_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Live Supabase/Postgres mode. Set PORTAL_DEMO_MODE=false and fill these.
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<supabase-anon-key>

# Optional assistant generation. Retrieval/source lookup works without this.
# STAFF_GENERATION_ENABLED=true
# GROQ_API_KEY=<groq-api-key>
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b

# Support chatbot Qwen endpoint. Defaults match the hackathon shared Ollama machine.
# SUPPORT_CHAT_USE_LLM=true
# OLLAMA_URL=http://100.72.1.8:11434
# OLLAMA_MODEL=qwen3:4b

# Marketplace/internal API settings used by the separate marketplace module.
# INTERNAL_API_KEY=<shared-internal-key>
